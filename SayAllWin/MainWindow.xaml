<Window x:Class="SayAll.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="无线麦 SayAll 设置"
        xmlns:local="clr-namespace:SayAll"
        Width="1020" Height="720"
        MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- 按键卡：名称 + 单击/双击/长按 三个子卡（选中任一下拉时卡片高亮蓝色） -->
        <DataTemplate DataType="{x:Type local:MappingRow}">
            <Border CornerRadius="10" Padding="12" Margin="0,0,0,10" Background="{StaticResource CardBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                <Setter Property="BorderBrush" Value="#0A84FF"/>
                                <Setter Property="BorderThickness" Value="1.6"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="{Binding IconGlyph}" FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <UniformGrid Columns="3">
                        <Border Background="{StaticResource SubCardBrush}" CornerRadius="8" Padding="8,6" Margin="0,0,4,0">
                            <StackPanel>
                                <TextBlock Text="{Binding TriggerSingle}" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <ComboBox Margin="0,4,0,0" MinWidth="0" MinHeight="26" FontSize="12"
                                          GotFocus="OnMappingComboGotFocus" LostFocus="OnMappingComboLostFocus"
                                          ItemsSource="{Binding Items}" SelectedIndex="{Binding SingleIndex, Mode=TwoWay}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SubCardBrush}" CornerRadius="8" Padding="8,6" Margin="2,0,2,0">
                            <StackPanel>
                                <TextBlock Text="{Binding TriggerDouble}" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <ComboBox Margin="0,4,0,0" MinWidth="0" MinHeight="26" FontSize="12"
                                          GotFocus="OnMappingComboGotFocus" LostFocus="OnMappingComboLostFocus"
                                          ItemsSource="{Binding Items}" SelectedIndex="{Binding DoubleIndex, Mode=TwoWay}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SubCardBrush}" CornerRadius="8" Padding="8,6" Margin="4,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding TriggerLong}" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <ComboBox Margin="0,4,0,0" MinWidth="0" MinHeight="26" FontSize="12"
                                          GotFocus="OnMappingComboGotFocus" LostFocus="OnMappingComboLostFocus"
                                          ItemsSource="{Binding Items}" SelectedIndex="{Binding LongIndex, Mode=TwoWay}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 语音键说明卡：不可配置，仅说明语音路径独立于按键映射 -->
        <DataTemplate DataType="{x:Type local:VoiceKeyInfoRow}">
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE720;" FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        <Border Background="#ECECF1" CornerRadius="5" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FixedLabel}" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 统计柱状图条目 -->
        <DataTemplate x:Key="BarTemplate">
            <StackPanel VerticalAlignment="Bottom" Margin="2,0">
                <TextBlock Text="{Binding ValueText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,3"/>
                <Border Height="{Binding BarHeight}" Background="{Binding Brush}" CornerRadius="4,4,0,0"
                        Width="26" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding DayText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </DataTemplate>

        <!-- 语音时长排行榜条目 -->
        <DataTemplate x:Key="TopRowTemplate">
            <Border BorderBrush="#EFEFF4" BorderThickness="0,0,0,1" Padding="4,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding RankText}" FontWeight="Bold" FontSize="13"
                               Foreground="{Binding RankBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding DurationText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding DateText}" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <TabControl x:Name="Tabs" SelectionChanged="OnTabChanged">

        <!-- ============ 连接与语音 ============ -->
        <TabItem x:Name="ConnectionTab" Tag="&#xE71B;">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock x:Name="ConnectionTitle" FontSize="22" FontWeight="Bold" Margin="0,0,0,14" Text="连接与语音"/>

                    <GroupBox x:Name="ConnectionGroup">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StateDot" Width="9" Height="9" Fill="{StaticResource GreenBrush}"
                                         VerticalAlignment="Center"/>
                                <TextBlock x:Name="BridgeStateLabel" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0" Text="—"/>
                            </StackPanel>
                            <TextBlock x:Name="BatteryLabel" FontSize="12" Margin="17,4,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" Text=""/>
                            <Button x:Name="ReconnectButton" Click="OnReconnectClick" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                            <TextBlock x:Name="ConnectionHintText" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" Text=""/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Name="VoiceGroup" Header="语音输出">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="AudioDeviceLabel" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox x:Name="AudioDeviceCombo" SelectionChanged="OnAudioDeviceChanged" MinWidth="330"/>
                                <Button x:Name="RefreshAudioButton" Click="OnRefreshAudioClick"/>
                            </StackPanel>
                            <TextBlock x:Name="AudioHintText" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock x:Name="GainLabel" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Slider x:Name="GainSlider" Minimum="-24" Maximum="24" SmallChange="1"
                                        LargeChange="3" ValueChanged="OnGainChanged"/>
                                <TextBlock x:Name="GainValueLabel" VerticalAlignment="Center" Margin="6,0,0,0" Text="0 dB"/>
                                <Button x:Name="TestToneButton" Click="OnTestToneClick" Margin="12,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Name="VoiceKeyGroup" Header="语音键">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="VoiceKeyModeLabel" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox x:Name="VoiceKeyModeCombo" SelectionChanged="OnVoiceKeyModeChanged" MinWidth="360"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ============ 按键映射 ============ -->
        <TabItem x:Name="MappingTab" Tag="&#xE765;">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="14,10" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="MappingStatusText" Grid.Column="0" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" Text=""/>
                        <CheckBox x:Name="FnTapCheck" Grid.Column="1" HorizontalAlignment="Right"
                                  Checked="OnFnTapChanged" Unchecked="OnFnTapChanged" Margin="12,0,12,0"/>
                        <Button x:Name="ResetMappingButton" Grid.Column="2" Click="OnResetMappingClick"/>
                    </Grid>
                </Border>

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock x:Name="MappingTitle" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Text="按键映射"/>
                    <CheckBox x:Name="MappingEnabledCheck" FlowDirection="RightToLeft"
                              Checked="OnMappingEnabledChanged" Unchecked="OnMappingEnabledChanged"
                              VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>

                <ScrollViewer x:Name="MappingScroll" VerticalScrollBarVisibility="Auto"
                              ScrollChanged="OnMappingScrollChanged">
                    <Grid x:Name="MappingRoot">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="175"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 引线层：连接按键卡与遥控器照片上的按键（最底层，不参与命中测试） -->
                        <Canvas Grid.Column="0" Grid.ColumnSpan="3" x:Name="WiringCanvas" IsHitTestVisible="False"/>

                        <ItemsControl Grid.Column="0" x:Name="MappingLeftItems"/>

                        <!-- 中央遥控器实物照片（原仓库 Resources/RC003-remote-photo.png，透明底） -->
                        <Rectangle Grid.Column="1" x:Name="RemotePhoto" Width="138" Height="500"
                                   RadiusX="16" RadiusY="16" VerticalAlignment="Top" Margin="4,6">
                            <Rectangle.Fill>
                                <ImageBrush ImageSource="/Assets/RC003-remote-photo.png"
                                            Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Top"/>
                            </Rectangle.Fill>
                        </Rectangle>

                        <ItemsControl Grid.Column="2" x:Name="MappingRightItems"/>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </TabItem>

        <!-- ============ 统计 ============ -->
        <TabItem x:Name="StatsTab" Tag="&#xE9D2;">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="860" HorizontalAlignment="Left">
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock x:Name="StatsTitle" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Text="统计"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#DFF5E4" CornerRadius="6" Padding="8,3" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock x:Name="StatsLocalTag" FontSize="11" Foreground="#248A3D" Text="数据仅存本机"/>
                            </Border>
                            <Border Background="#ECECF1" CornerRadius="9" Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="StatsDayRadio" GroupName="stats" Style="{StaticResource SegmentRadio}"
                                                 Checked="OnStatsRangeChanged" IsChecked="True"/>
                                    <RadioButton x:Name="StatsWeekRadio" GroupName="stats" Style="{StaticResource SegmentRadio}"
                                                 Checked="OnStatsRangeChanged"/>
                                    <RadioButton x:Name="StatsAllRadio" GroupName="stats" Style="{StaticResource SegmentRadio}"
                                                 Checked="OnStatsRangeChanged"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="10" Margin="0,0,6,10" Padding="16">
                            <StackPanel>
                                <TextBlock x:Name="StatsPressesTitle" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock x:Name="StatsPressesLabel" FontSize="24" FontWeight="Bold" Text="0" Margin="0,2,0,0"/>
                                <ItemsControl x:Name="PressesBars" Height="196" Margin="0,8,0,0"
                                              ItemTemplate="{StaticResource BarTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="7" VerticalAlignment="Bottom"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="10" Margin="6,0,0,10" Padding="16">
                            <StackPanel>
                                <TextBlock x:Name="StatsVoiceTitle" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock x:Name="StatsVoiceLabel" FontSize="24" FontWeight="Bold" Text="0" Margin="0,2,0,0"/>
                                <ItemsControl x:Name="VoiceBars" Height="196" Margin="0,8,0,0"
                                              ItemTemplate="{StaticResource BarTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="7" VerticalAlignment="Bottom"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel>
                            <TextBlock x:Name="StatsTopTitle" FontWeight="SemiBold" FontSize="14" Text="单次语音时长排行"/>
                            <TextBlock x:Name="StatsTopHint" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,2,0,6" Text=""/>
                            <ItemsControl x:Name="VoiceTopList" ItemTemplate="{StaticResource TopRowTemplate}"/>
                            <TextBlock x:Name="StatsTopEmpty" Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ============ 回眸（录音） ============ -->
        <TabItem x:Name="RecordingTab" Tag="&#xE720;">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock x:Name="RecordingTitle" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Text="回眸"/>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="14,10" Margin="0,10,0,0">
                    <Button x:Name="OpenRecordingsButton" Click="OnOpenRecordingsClick" HorizontalAlignment="Right"/>
                </Border>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                        <StackPanel>
                            <CheckBox x:Name="TranscriptEnabledCheck"
                                      Checked="OnTranscriptEnabledChanged" Unchecked="OnTranscriptEnabledChanged"/>
                            <CheckBox x:Name="RecordingEnabledCheck" Margin="4,8,4,2"
                                      Checked="OnRecordingEnabledChanged" Unchecked="OnRecordingEnabledChanged"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="8">
                        <ListBox x:Name="TranscriptList" HorizontalContentAlignment="Stretch"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Header}"/>
                                            <TextBlock Text="{Binding Time}" Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </DockPanel>
        </TabItem>

        <!-- ============ 关于 ============ -->
        <TabItem x:Name="AboutTab" Tag="&#xE946;">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                    <TextBlock x:Name="AboutTitle" FontSize="22" FontWeight="Bold" Margin="0,0,0,14" Text="无线麦 SayAll（Windows）"/>
                    <GroupBox x:Name="AboutGroup" Header="关于">
                        <StackPanel>
                            <TextBlock x:Name="VersionLabel" Text="" Margin="0,2"/>
                            <TextBlock x:Name="AboutDescriptionText" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox x:Name="PrefsGroup" Header="偏好设置">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock x:Name="LanguageLabel" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox x:Name="LanguageCombo" SelectionChanged="OnLanguageChanged" MinWidth="180"/>
                            </StackPanel>
                            <CheckBox x:Name="AutoStartCheck" Margin="0,8,0,2"
                                      Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged"/>
                            <CheckBox x:Name="McpCheck" IsEnabled="False" Margin="0,6,0,0"/>
                            <TextBlock x:Name="McpHint" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                       FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </GroupBox>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button x:Name="GithubButton" Click="OnGithubClick"/>
                        <Button x:Name="ReleasesButton" Click="OnReleasesClick"/>
                        <Button x:Name="LogButton" Click="OnLogClick"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>